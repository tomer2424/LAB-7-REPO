<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="il.cshaifasweng.OCSFMediatorExample.client.PrimaryController">
   <children>
      <Label text="Tic Tac Toe" style="-fx-font-size: 28; -fx-font-weight: bold;" />
      <Label fx:id="statusLabel" text="Waiting for opponent..." style="-fx-font-size: 14;" />

      <GridPane fx:id="gameBoard" alignment="CENTER" hgap="5" vgap="5"
                style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 10;">
      </GridPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>