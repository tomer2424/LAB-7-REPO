<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.LoginController">
   <children>
      <Label text="Tic Tac Toe - Connect to Server" style="-fx-font-size: 20; -fx-font-weight: bold;" />

      <HBox spacing="10.0" alignment="CENTER">
         <children>
            <Label text="Host:" style="-fx-font-size: 14;" />
            <TextField fx:id="hostField" prefWidth="200.0" />
         </children>
      </HBox>

      <HBox spacing="10.0" alignment="CENTER">
         <children>
            <Label text="Port:" style="-fx-font-size: 14;" />
            <TextField fx:id="portField" prefWidth="200.0" />
         </children>
      </HBox>

      <Button fx:id="connectButton" text="Connect" onAction="#onConnectClicked" style="-fx-font-size: 14;" prefWidth="150.0" />

      <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 12; -fx-text-fill: blue;" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>

